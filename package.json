{
  "name": "home-exchange-uniapp",
  "version": "0.1.0",
  "private": true,
  "description": "房屋互换项目客户端（uni-app + Vue3），支持微信小程序 / H5 / App",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-weixin:test": "uni -p mp-weixin --mode test",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:test": "uni build -p mp-weixin --mode test",
    "build:app": "uni build -p app",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{js,ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,scss}\""
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-app-plus": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5030420261029002",
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/uni-stacktracey": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.24.1",
    "prettier": "^3.2.5",
    "sass": "^1.75.0",
    "typescript": "^5.4.5",
    "vite": "5.2.8",
    "vue-tsc": "^2.0.13"
  }
}
